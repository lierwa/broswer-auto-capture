{
  "name": "@browser-capture/antibot-lab-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "files": ["*.ts", "*.py", "*.go", "*.c", "*.js", "*.css", "*.html", "*.json", "*.mjs", "*.mts", "*.cmd", "*.lua", "README.md", "THIRD_PARTY_NOTICES.md", "tests/", "shared/", "deployment/"],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "lab": "node lab.ts",
    "start": "node lab.ts start",
    "status": "node lab.ts status",
    "stop": "node lab.ts stop",
    "prepare": "node lab.ts prepare",
    "check": "tsc --noEmit",
    "test": "node --experimental-vm-modules --test tests/*.test.ts",
    "fixtures": "powershell -NoProfile -File tests/prepare-fixtures.ps1",
    "release": "node release.ts",
    "release:runtime": "node runtime-release.ts",
    "mac": "node mac-host.ts"
  },
  "dependencies": {
    "csrf-sync": "4.2.1",
    "lru-cache": "11.4.0",
    "structured-headers": "2.0.3",
    "svg-captcha": "1.4.0",
    "zod": "4.1.8"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "esbuild": "0.25.12",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2"
  }
}
