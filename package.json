{
  "name": "browser-capture-tool",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ai-connect:sync": "node scripts/ai-connect-sync.mjs",
    "dev": "node --import tsx scripts/dev.mjs",
    "dev:api": "cross-env BROWSER_CAPTURE_SERVE_UI=false npm run dev --workspace @browser-capture/api",
    "dev:web": "npm run dev --workspace @browser-capture/workbench -- --host 127.0.0.1 --port 4173 --strictPort",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "node --import tsx --test tests/*.test.mjs && npm run test --workspaces --if-present"
  },
  "aiConnect": {
    "vendorDirectory": "vendor/agent-platform",
    "manifests": {
      "@agent-platform/ai-connect": [
        "apps/api/package.json",
        "apps/workbench/package.json",
        "packages/contracts/package.json"
      ],
      "@agent-platform/ai-connect-react": [
        "apps/workbench/package.json"
      ]
    }
  },
  "devDependencies": {
    "cross-env": "10.1.0",
    "find-process": "2.1.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "zod": "4.1.8"
  }
}
