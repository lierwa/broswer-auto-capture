# Optional Node HTTP(S)_PROXY / http(s)_proxy support for npm run dev and API start.
# Copy to .env only when using a trusted proxy already configured in the shell.
# Node >=24.5 supports this switch. No proxy address or credentials are committed.
NODE_USE_ENV_PROXY=1
# Keep the workbench, model bridge, extension relay and local sites on loopback.
NO_PROXY=localhost,127.0.0.1,::1,.localhost
